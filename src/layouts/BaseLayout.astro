---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, services, reviews } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  showMobileNav?: boolean;
  stickyNav?: boolean;
  homeLinks?: boolean;
  robots?: string;
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  type = 'website',
  showMobileNav = true,
  stickyNav = true,
  homeLinks = true,
  robots = 'index, follow',
} = Astro.props;

const siteURL = Astro.site ?? new URL(site.url);
const siteOrigin = new URL(withBase('/'), siteURL).href.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(withBase(image), siteURL);
const founderImageURL = new URL(withBase('/favicon.svg'), siteURL);

const businessId = `${siteOrigin}/#business`;
const websiteId = `${siteOrigin}/#website`;
const founderId = `${siteOrigin}/#founder`;

const ratings = reviews.map((review) => review.rating);
const ratingValue =
  ratings.reduce((total, rating) => total + rating, 0) / (ratings.length || 1);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': businessId,
      name: site.name,
      legalName: site.legalName,
      url: siteOrigin,
      email: site.email,
      description: site.description,
      image: imageURL.href,
      logo: founderImageURL.href,
      priceRange: site.priceRange,
      areaServed: site.areaServed,
      address: {
        '@type': 'PostalAddress',
        addressCountry: site.addressCountry,
        ...(site.addressLocality ? { addressLocality: site.addressLocality } : {}),
        ...(site.addressRegion ? { addressRegion: site.addressRegion } : {}),
      },
      founder: { '@id': founderId },
      ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
      knowsAbout: [
        'Platform Management',
        'Social Media Strategy',
        'Content Creation',
        'Social Media Audit',
        'Creative Asset Design',
        'Paid Ads',
        'Engagement',
        'Scheduling & Content Planning',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Services',
        itemListElement: services.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service.name,
            description: service.description,
          },
        })),
      },
      ...(reviews.length
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: ratingValue.toFixed(1),
              reviewCount: reviews.length,
              bestRating: 5,
              worstRating: 1,
            },
            review: reviews.map((review) => ({
              '@type': 'Review',
              reviewBody: review.quote.replace(/^"|"$/g, ''),
              author: { '@type': 'Person', name: review.name },
              reviewRating: {
                '@type': 'Rating',
                ratingValue: review.rating,
                bestRating: 5,
                worstRating: 1,
              },
            })),
          }
        : {}),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: siteOrigin,
      description: site.description,
      inLanguage: 'en-GB',
      publisher: { '@id': businessId },
    },
    {
      '@type': 'Person',
      '@id': founderId,
      name: site.founderName,
      jobTitle: 'Founder',
      image: founderImageURL.href,
      worksFor: { '@id': businessId },
      url: siteOrigin,
    },
  ],
};

const enableGtm = Boolean(site.gtmId);
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      enableGtm && (
        <script define:vars={{ gtmId: site.gtmId }} is:inline>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700;800&family=Source+Serif+4:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body
    class="min-h-screen bg-page text-ink antialiased selection:bg-accent/15 selection:text-ink"
  >
    {
      enableGtm && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <Nav showMobileNav={showMobileNav} sticky={stickyNav} homeLinks={homeLinks} />
    <slot />
    <Footer />
    <script src="../scripts/main.js"></script>
  </body>
</html>
