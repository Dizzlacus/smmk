---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import beachImage from '../assets/images/beach-parallax.png';
---

<section
  id="impact"
  class="relative h-[500px] max-h-[500px] overflow-hidden"
  aria-label="Impact"
>
  <div
    id="impact-bg"
    class="absolute inset-x-0 -top-[15%] h-[130%] w-full will-change-transform"
  >
    <Picture
      src={beachImage}
      formats={['avif', 'webp']}
      alt=""
      class="h-full w-full object-cover"
      width={1024}
      height={706}
      layout="full-width"
      widths={[640, 960, 1024]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
  </div>

  <div class="absolute inset-0 bg-ink/45" aria-hidden="true"></div>

  <div class="relative z-10 flex h-full items-center justify-center px-5">
    <p class="max-w-xl text-center font-display text-3xl font-bold tracking-[-0.03em] text-page md:text-4xl">
      {site.impactHeadline}
    </p>
  </div>
</section>
