---
import { site } from '../data/site';
import FounderPortrait from './FounderPortrait.astro';

const [titleLine1, titleLine2] = (() => {
  const words = site.heroDisplayTitle.trim().split(/\s+/);
  if (words.length < 2) return [site.heroDisplayTitle, ''];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
})();
---

<section
  id="hero"
  class="hero-overlap relative isolate bg-page pt-24 md:pt-28"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute left-[-10%] bottom-[-15%] h-[45%] w-[45%] rounded-full bg-[radial-gradient(circle_at_center,rgba(92,100,112,0.06),transparent_70%)]"
    >
    </div>
  </div>

  <div class="relative px-5 pb-16 md:px-10 lg:px-16 lg:pb-24">
    <div
      class="mx-auto grid w-full max-w-7xl items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14"
    >
      <div class="hero-copy relative z-10 max-w-3xl">
        <p
          class="text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-accent-soft md:text-xs"
        >
          {site.heroEyebrow}
        </p>

        <h1
          class="hero-display-title mt-5 -ml-[0.08em] font-condensed text-[clamp(3rem,12vw,128px)] font-semibold leading-[0.85] tracking-[-0.03em] text-ink uppercase"
        >
          <span class="block">{titleLine1}</span>
          {
            titleLine2 && (
              <span class="block text-accent">{titleLine2}</span>
            )
          }
        </h1>

        <p class="mt-7 max-w-md text-base leading-7 text-ink/60 md:mt-8 md:text-lg md:leading-8">
          {site.heroSubhead}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a
            href="#services"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-bold text-page transition-colors hover:bg-accent-soft active:bg-ink"
          >
            <span>{site.heroCta}</span>
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0-4 4m4-4H3"
              ></path>
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink/70 underline decoration-ink/20 underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
          >
            <span>{site.heroCtaSecondary}</span>
          </a>
        </div>
      </div>

      <aside class="hero-portrait relative z-10 mx-auto w-full max-w-md lg:mx-0 lg:justify-self-end">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] border border-ink/10 bg-ink/[0.04]"
        >
          <FounderPortrait
            loading="eager"
            fetchpriority="high"
            widths={[400, 560, 720]}
            sizes="(min-width: 1024px) 28vw, (min-width: 768px) 40vw, 90vw"
          />
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero-copy {
    animation: hero-copy-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
  }

  .hero-display-title {
    transform-origin: left center;
    animation: hero-title-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-portrait {
    animation: hero-copy-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-title-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-display-title,
    .hero-portrait {
      animation: none;
    }
  }
</style>
