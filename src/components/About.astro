---
import { site } from '../data/site';
import FounderPortrait from './FounderPortrait.astro';
---

<section id="about" class="bg-page reveal">
  <div class="px-5 py-12 md:px-10 md:py-14 lg:px-16 lg:py-24">
    <div class="max-w-7xl mx-auto grid gap-10 lg:gap-20 lg:grid-cols-[0.9fr_1.1fr] items-center">
      <div class="glass-card accent-glow relative min-h-[420px] overflow-hidden rounded-[2rem] p-6">
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(42,47,58,0.08),transparent_32%),radial-gradient(circle_at_80%_80%,rgba(26,28,30,0.04),transparent_30%)]"
          aria-hidden="true"></div>
        <div class="relative h-full min-h-[372px] overflow-hidden rounded-[1.5rem] border border-ink/10">
          <FounderPortrait
            loading="lazy"
            widths={[480, 720, 800]}
            sizes="(min-width: 1024px) 40vw, 90vw"
          />
        </div>
      </div>

      <div>
        <p class="section-kicker">About</p>
        <h2
          class="mt-5 font-display text-4xl font-bold tracking-[-0.04em] text-ink md:text-6xl"
        >
          {site.aboutHeadline}{' '}
          <span class="text-accent">{site.aboutHeadlineAccent}</span>
        </h2>
        <div class="mt-7 space-y-5 text-lg leading-8 text-ink/55">
          {site.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a
          href="#contact"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-bold text-page transition-colors hover:bg-accent-soft active:bg-ink"
        >
          {site.aboutCta}
        </a>
      </div>
    </div>
  </div>
</section>
